{
  "name": "gravityops/folders",
  "repositories": {
    "gravityops-local": {
      "type": "path",
      "url": "../../../gravityops",
      "options": {
        "symlink": true
      }
    },
    "gravityops-remote": {
      "type": "vcs",
      "url": "git@github.com:BrightLeaf-Digital/gravityops.git",
      "no-api": true
    }
  },
  "require": {
    "gravityops/core": "2.0.9"
  },
  "require-dev": {
    "gravityops/core": "dev-main as 2.0.9"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "strauss": {
      "target_directory": "vendor/F4G",
      "namespace_prefix": "F4G\\",
      "classmap_prefix": "F4G_",
      "constant_prefix": "F4G_",
      "packages": [
        "gravityops/core",
        "trustedlogin/client",
        "league/commonmark",
        "league/config",
        "dflydev/dot-access-data",
        "nette/schema",
        "nette/utils",
        "psr/event-dispatcher",
        "symfony/deprecation-contracts",
        "symfony/polyfill-php80"
      ],
      "delete_vendor_packages": true,
      "update_call_sites": [
        "includes",
        "folders-4-gravity.php"
      ],
      "exclude_from_copy": {
        "file_patterns": [
          "(^|/)\\.git(/|$)",
          "(^|/)\\.github(/|$)",
          "\\.git(ignore|modules|attributes)$",
          "(^|/)tests(/|$)"
        ]
      }
    }
  },
  "config": {
    "preferred-install": {
      "gravityops/core": "source",
      "*": "dist"
    }
  }
}
